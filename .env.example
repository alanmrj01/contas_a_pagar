# Armazenamento efêmero/temporário da aplicação.
# Em produção, não use disco persistente para sessões financeiras temporárias.
# WEB_DATA_DIR=/tmp/contas-a-pagar

# Segurança - defaults já são aplicados caso estas variáveis não existam.
WEB_SESSION_TTL_SECONDS=7200
MAX_UPLOAD_BYTES=209715200
UPLOAD_CHUNK_BYTES=16777216
MAX_SESSION_STAGED_BYTES=2147483648
MAX_OFFICE_EXPANDED_BYTES=2147483648
MAX_HEAVY_JOBS=1

# Supabase Auth + persistência cifrada da BASE DADOS.
# Nunca adicione chaves reais ao Git/GitHub. Configure-as somente no Render/local.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUBSTITUA
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA

# Chave aleatória de 32 bytes em Base64 URL-safe. Não reutilize senha humana.
# Gere localmente com: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
PERSISTENT_BASE_KEY_B64=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_32_BYTES
